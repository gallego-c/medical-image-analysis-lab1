    "phi1 = np.empty([N1, M])\n",
    "for i in range(N1):\n",
    "    for j in range(M):\n",
    "        phi1[i][j] = np.cos(np.pi*j*(i + 1/2)/N1)\n",
    "        if j == 0:\n",
    "            phi1[i][j] /= np.sqrt(2)\n",
    "phi2 = np.empty([N2, M])\n",
    "for i in range(N2):\n",
    "    for j in range(M):\n",
    "        phi2[i][j] = np.cos(np.pi*j*(i + 1/2)/N2)\n",
    "        if j == 0:\n",
    "            phi2[i][j] /= np.sqrt(2)\n",
    "\n",
    "phi_2D = np.kron(phi2, phi1)\n",
    "\n",
    "global_min = phi_2D.min()\n",
    "global_max = phi_2D.max()\n",
    "\n",
    "fix, ax = plt.subplots(M, M, figsize=(12, 12))\n",
    "\n",
    "for i in range(M):\n",
    "    for j in range(M):\n",
    "        k = j * M + i \n",
    "        \n",
    "        basis_vector = phi_2D[:, k]\n",
    "        basis_image = basis_vector.reshape(N1, N2, order='F')\n",
    "        \n",
    "        ax[i][j].imshow(basis_image, cmap='gray', aspect='equal', vmin=global_min, vmax=global_max, interpolation='nearest')\n",
    "        \n",
    "        ax[i][j].set_xticks([0, N2])\n",
    "        ax[i][j].set_yticks([0, N1])\n",
    "        ax[i][j].tick_params(labelsize=8)\n",
    "\n",
    "plt.tight_layout(pad=1.5)\n",
    "plt.show()\n",
    "\n",
    "tFlattened = T.reshape(-1, 1, order='F')\n",
    "\n",
    "tPhi_2D = phi_2D.T\n",
    "S_2D = np.matmul(tPhi_2D, phi_2D)\n",
    "S_2D = np.matmul(phi_2D, np.linalg.inv(S_2D))\n",
    "S_2D = np.matmul(S_2D, tPhi_2D)\n",
    "\n",
    "tHat_2D = S_2D @ tFlattened\n",
    "\n",
    "THat_2D = tHat_2D.reshape(N1, N2, order='F')\n",
    "\n",
    "fix, ax = plt.subplots(1, 2, figsize=(12, 6))\n",
    "ax[0].imshow(T, cmap='gray', aspect='equal')\n",
    "ax[0].set_title(\"Original Image\")\n",
    "\n",
    "ax[1].imshow(THat_2D, cmap='gray', aspect='equal')\n",
    "ax[1].set_title(f\"Smoothed Image (M={M})\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
