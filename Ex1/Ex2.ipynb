    "# B-spline function\n",
    "\n",
    "def b_spline(x, k):\n",
    "\n",
    "    # Order 0\n",
    "    if k == 0:\n",
    "        if -0.5 <= x < 0.5:\n",
    "            return 1\n",
    "        elif np.abs(x) == 0.5:\n",
    "            return 0.5\n",
    "        else:\n",
    "            return 0\n",
    "    # Order 1\n",
    "    elif k == 1:\n",
    "        if -1 <= x < 0:\n",
    "            return x + 1\n",
    "        elif 0 <= x < 1:\n",
    "            return -x + 1\n",
    "        else:\n",
    "            return 0\n",
    "    # Order 3\n",
    "    elif k == 3:\n",
    "        if np.abs(x) < 1:\n",
    "            return (2/3-np.abs(x)**2 + 0.5*np.abs(x)**3)\n",
    "        elif 1 <= np.abs(x) < 2:\n",
    "            return (1/6)*(2-np.abs(x))**3\n",
    "        else:\n",
    "            return 0\n",
    "    else:\n",
    "        raise ValueError(\"Unsupported B-spline order. Only k=0,1,3 are supported.\")"
   ]
